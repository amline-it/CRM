{
  "name": "crm-realestate",
  "version": "1.0.0",
  "private": true,
  "description": "CRM املاک — موتور گردش‌کار داده‌محور، پنل کارمندی، سینک با سرور اصلی",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --no-warnings scripts/migrate.mjs",
    "seed": "node --no-warnings scripts/seed.mjs",
    "e2e": "node --no-warnings scripts/e2e.mjs",
    "setup": "npm run migrate && npm run seed",
    "diagrams": "node --no-warnings scripts/generate-diagrams.mjs",
    "diagrams:check": "node --no-warnings scripts/generate-diagrams.mjs --check",
    "diagrams:view": "node --no-warnings scripts/diagram-viewer.mjs",
    "diagrams:vendor": "node --no-warnings scripts/vendor-mermaid.mjs",
    "flowchart": "node --no-warnings scripts/generate-flowchart.mjs",
    "docker:build": "docker build -t crm-realestate .",
    "test:browser": "BROWSER_FLOW_BASE=${BROWSER_FLOW_BASE:-http://127.0.0.1:3000} vitest run tests/session-browser-flow.test.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.5"
  }
}
