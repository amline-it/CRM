# ── پایه ─────────────────────────────────────────────────────────────
# آدرس عمومی سامانه (برای ساخت لینک‌ها و وبهوک)
APP_URL=http://localhost:3000
# کلید امضای کوکی جلسه (حداقل ۳۲ کاراکتر تصادفی) — با `openssl rand -hex 32` بسازید
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
NODE_ENV=development

# سیاست SameSite کوکی نشست: lax (پیش‌فرض تولید) | strict | none
# اگر پنل داخل iframe یا دامنه دیگری نمایش داده می‌شود، none بگذارید (کوکی Secure/Partitioned می‌شود)
SESSION_COOKIE_SAMESITE=lax

# ── دیتابیس ──────────────────────────────────────────────────────────
# مسیر فایل SQLite (نسبت به ریشه پروژه)؛ برای Postgres در آینده از آداپتور استفاده کنید
DATABASE_PATH=data/crm.db

# ── سینک با سرور اصلی ────────────────────────────────────────────────
# کلید API که سرور شما در هدر X-Sync-Key می‌فرستد
SYNC_API_KEY=change-me-sync-api-key
# راز امضای HMAC بدنه (هدر X-Signature: sha256=...)
SYNC_SECRET=change-me-hmac-secret
# فعال/غیرفعال‌بودن کانال واکشی (pull) در راه‌اندازی
SYNC_PULL_ENABLED=false
# آدرس API سرور شما برای واکشی (در صورت فعال‌بودن pull)
SYNC_PULL_URL=
# کلید خواندن از سرور شما
SYNC_PULL_API_KEY=
# فاصله واکشی به دقیقه
SYNC_PULL_INTERVAL_MINUTES=15

# ── وب‌هوک خروجی (CRM → سرور شما) ───────────────────────────────────
WEBHOOK_TARGET_URL=
# راز امضای وبهوک خروجی (اگر خالی باشد از SYNC_SECRET استفاده می‌شود)
WEBHOOK_SECRET=

# ── SSO اختیاری (ورود کارمندان با توکن سرور شما) ────────────────────
SSO_ENABLED=false
# راز مشترک HS256 برای اعتبارسنجی JWT صادرشده توسط سرور شما
SSO_JWT_SECRET=
# اسیر (issuer) و مخاطب (audience) مورد انتظار — اختیاری
SSO_ISSUER=
SSO_AUDIENCE=

# ── آداپتورها ────────────────────────────────────────────────────────
# sandbox | zarinpal  (پیاده‌سازی واقعی در فاز بعد؛ سندباکس برای توسعه و تست)
PAYMENT_PROVIDER=sandbox
# sandbox | manual | samaneh (اتصال رسمی در صورت وجود API)
TRACKING_PROVIDER=manual
# log | kavenegar | smtp
NOTIFICATION_PROVIDER=log

# پذیرش توکن نشست از هدر (X-Session-Ticket / Authorization: Bearer) در کنار کوکی
# برای محیط‌هایی که کوکی مسدود می‌شود (پنل داخل iframe، پروکسی سخت‌گیر). پیش‌فرض: true
ALLOW_HEADER_SESSION=true

# ── پیش‌نمایش/توسعه ─────────────────────────────────────────────────
# دامنه‌های مجاز توسعه (با کاما جدا کنید) — پیش‌نمایش Arena به‌صورت پیش‌فرض مجاز است
ALLOWED_DEV_ORIGINS=*.e2b.app,*.arena.ai

# ---------------------------------------------------------------- امنیت نمایش
# دامنه‌هایی که اجازه دارند پنل را داخل iframe نمایش دهند (جدا با فاصله).
# پیش‌فرض خالی = 'self' + دامنه‌های ALLOWED_DEV_ORIGINS. برای بستن کامل: none
FRAME_ANCESTORS=
