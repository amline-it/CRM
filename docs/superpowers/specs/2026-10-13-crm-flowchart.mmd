    listing_closed["بسته‌شدن آگهی<br/><span style='font-size:10px'>listing_closed</span>"]
    listing_start -->|"⚙ بررسی شرایط مالی آگهی"| listing_finance
    listing_finance -->|"▶ تأیید شرایط مالی (پرداخت، اشتراک یا معافیت)"| listing_info
    listing_info -->|"▶ تکمیل اطلاعات و مدارک آگهی"| listing_review
    listing_review -->|"▶ ثبت نتیجه بررسی کارشناس"| listing_result
    listing_result -->|"▶ اعلام نقص یا علت رد"| listing_needs_fix
    listing_needs_fix -->|"▶ اصلاح و ارسال مجدد آگهی"| listing_info
    listing_result -->|"▶ انتشار آگهی"| listing_published
