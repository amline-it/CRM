  subgraph SG_custom_service["قالب سایر خدمات"]
    direction TB
    service_start["شروع خدمت<br/><span style='font-size:10px'>service_start</span>"]:::start
    service_details["تکمیل اطلاعات و مدارک خدمت<br/><span style='font-size:10px'>service_details</span>"]
    service_finance["بررسی شرایط مالی خدمت<br/><span style='font-size:10px'>service_finance</span>"]:::decision
    service_finance_error["خطای مالی و پیگیری<br/><span style='font-size:10px'>service_finance_error</span>"]:::errorState
    service_execution["اجرای مراحل اختصاصی خدمت<br/><span style='font-size:10px'>service_execution</span>"]
    service_review["بررسی و تأیید نتیجه<br/><span style='font-size:10px'>service_review</span>"]
    service_needs_fix["اعلام نقص و درخواست اصلاح<br/><span style='font-size:10px'>service_needs_fix</span>"]:::errorState
    service_delivered["تحویل نتیجه خدمت<br/><span style='font-size:10px'>service_delivered</span>"]
    service_cancelled["لغو خدمت<br/><span style='font-size:10px'>service_cancelled</span>"]
    service_start -->|"▶ تکمیل اطلاعات و مدارک خدمت"| service_details
    service_details -->|"▶ بررسی شرایط مالی خدمت"| service_finance
    service_finance & service_finance_error -->|"▶ تأیید شرایط مالی خدمت"| service_execution
    service_finance -->|"▶ ثبت خطای مالی و پیگیری"| service_finance_error
    service_execution -->|"▶ اعلام نتیجه اجرای خدمت"| service_review
    service_review -->|"▶ تأیید نتیجه خدمت و تحویل"| service_delivered
    service_review -->|"▶ اعلام نقص و درخواست اصلاح"| service_needs_fix
    service_needs_fix -->|"▶ اصلاح و اجرای مجدد"| service_execution
    service_details & service_finance & service_finance_error & service_execution & service_review & service_needs_fix -->|"▶ لغو خدمت"| service_cancelled
