    requirements_fulfilled["نیازمندی تأمین شد<br/><span style='font-size:10px'>requirements_fulfilled</span>"]
    requirements_expired["انقضای نیازمندی<br/><span style='font-size:10px'>requirements_expired</span>"]
    requirements_cancelled["لغو توسط متقاضی<br/><span style='font-size:10px'>requirements_cancelled</span>"]
