  classDef terminal fill:#dcfce7,stroke:#15803d,color:#14532d;
  classDef decision fill:#fef3c7,stroke:#b45309,color:#78350f;
  classDef errorState fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d;

